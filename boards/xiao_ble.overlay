/*
 * Board wiring for the BL0937 mains-plug retrofit. See docs/smart-plug-plan.md
 * for the full design.
 *
 * The plug's 11-pad header was traced by continuity probing
 * (docs/original-pcb-trace.md) and then cross-checked against the
 * disassembled stock firmware (docs/original-firmware.md), which is treated
 * as authoritative where the two disagree. Note either source fixes which
 * *header pad* carries each signal, not which XIAO pin it lands on: the XIAO
 * is wired to that header by hand, so the pin choices below are ours to make,
 * and are chosen for XIAO-side capability (ADC availability, edge-connector
 * access).
 *
 * Board target: xiao_ble (plain, no IMU/microphone) -- confirmed by physical
 * inspection, no LSM6DSL/microphone package on the board. The plain and
 * Sense variants share the same D0-D10 connector pinout
 * (seeed_xiao_connector.dtsi is common to both); Sense only adds the IMU/mic
 * devicetree nodes and enables I2C0 for them, which is why no
 * IMU-disable node is needed here.
 *
 * Pad budget, derived from docs/pinout.md (Seeed's XIAO nRF52840 reference)
 * and cross-checked against
 * zephyr/boards/seeed/xiao_ble/seeed_xiao_connector.dtsi:
 *
 *   XIAO pin      Header pad        Signal
 *   ------------  ----------------  ---------------------------------------
 *   D0 / P0.02    H5  (RX1)         plug tactile switch (short = toggle
 *                                   relay, long = factory reset; handled by
 *                                   the Matter common board layer's function
 *                                   button, see
 *                                   samples/matter/common/src/board/board.cpp)
 *   D1 / P0.03    H4  (P7)          plug LED 2 (network/commissioning state)
 *   D2 / P0.28    H9  (P24)         BL0937 CF  (active-power pulse),
 *                                   ADC-capable pad kept in reserve in case
 *                                   pulse counting needs an analog fallback
 *   D3 / P0.29    H11 (P26)         BL0937 CF1 (V/I pulse, muxed by SEL),
 *                                   same ADC reasoning
 *   D4 / P0.04    H6  (P8)          BL0937 SEL (V/I select output)
 *   D5 / P0.05    H2  (P6)          relay drive
 *
 * Power: the plug's H1 (3.3V) and H3 (GND) tie to the XIAO's 3.3V-OUT and
 * GND pads. H7 (TX1) is a no-connect on the host board. H8 (ADC) and H10
 * (CEN) are both unused: probing could not reach them, and the stock
 * firmware never drives them.
 *
 * Only ONE plug LED is software-driven. The board carries two, but the stock
 * firmware only ever drives H4 (P7) as an LED -- its second LED output is
 * module pin P9, which the UAM023 does not bring out to the header at all.
 * The reconciliation is that the LED probing found on H2 sits on the relay
 * drive net itself, so it follows the relay in hardware and needs no GPIO of
 * its own. That is also why probing read H2 as "LED 1" while the firmware
 * drives it as the relay: both are on that net. Driving H2 therefore gets
 * relay-state indication for free.
 *
 * So LED 2 (D1) mirrors network/commissioning state and is the only plug LED
 * this firmware writes. Its polarity is assumed active-low, matching the
 * on-board RGB LED (xiao_ble_common.dtsi); confirm independently.
 *
 * All six signals sit on the edge connector, so every joint is solderable
 * and inspectable. An earlier revision put LED 1 on P0.17 (the module's
 * internal CHARGE_LED pin) to save a connector pad; with only seven signals
 * against eleven pads there is no pad pressure, so that underside solder
 * joint was not worth its cost. D6-D10 remain free as spares.
 *
 * All GPIO producer/consumer nodes below reuse Zephyr's "gpio-leds" /
 * "gpio-keys" bindings even where the node is not literally an LED or a key
 * (SEL is an output that is neither; CF/CF1 are pulse inputs, not buttons).
 * That is deliberate, not cosmetic: only a node with a *binding* gets its
 * "gpios" property expanded by the devicetree generator into the .port/.pin
 * fields GPIO_DT_SPEC_GET() needs -- a bare node with no "compatible" does
 * not, and fails to build. gpio-leds/gpio-keys are simply the two bindings
 * Zephyr ships whose child schema is "one gpios property, nothing else",
 * which is all any of these signals needs; no LED or button driver actually
 * attaches to bl0937_sel/cf/cf1 or relay_drive, they're read/driven with
 * plain GPIO calls the same way src/status_led.cpp and src/relay.cpp already
 * do for led0-led4.
 */

/ {
	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Plug switch (D0 <- H5)";
		};
	};

	bl0937_pulses: bl0937_pulses {
		compatible = "gpio-keys";

		bl0937_cf: bl0937_cf {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "BL0937 CF (D2)";
		};

		bl0937_cf1: bl0937_cf1 {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "BL0937 CF1 (D3)";
		};
	};

	aliases {
		sw0 = &button0;
		led4 = &plug_led_network;
	};

	leds {
		compatible = "gpio-leds";

		plug_led_network: plug_led_network {
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			label = "Plug LED 2 (network state, D1)";
		};

		relay_drive: relay_drive {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			label = "Relay drive (D5 -> H2/P6)";
		};

		bl0937_sel: bl0937_sel {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "BL0937 SEL (D4)";
		};
	};
};
