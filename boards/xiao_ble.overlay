/*
 * Board wiring for the BL0937 mains-plug retrofit. See docs/smart-plug-plan.md
 * for the full design; pin choices here are PROVISIONAL until the plug's PCB
 * is traced (docs/plug-pinout.md) -- only this file should need to change
 * once that trace confirms or corrects the assignment.
 *
 * Board target: xiao_ble (plain, no IMU/microphone) -- confirmed by physical
 * inspection, no LSM6DSL/microphone package on the board. The plain and
 * Sense variants share the same D0-D10 connector pinout
 * (seeed_xiao_connector.dtsi is common to both); Sense only adds the IMU/mic
 * devicetree nodes and enables I2C0 for them, which is why no
 * IMU-disable node is needed here.
 *
 * Pad budget, derived from docs/pinout.md (Seeed's XIAO nRF52840 reference)
 * and cross-checked against
 * zephyr/boards/seeed/xiao_ble/seeed_xiao_connector.dtsi:
 *
 *   D0 / P0.02  - plug tactile switch (short = toggle relay, long = factory
 *                 reset; handled by the Matter common board layer's function
 *                 button, see samples/matter/common/src/board/board.cpp)
 *   D1 / P0.03  - plug LED 2 (network/commissioning state indicator)
 *   D2 / P0.28  - BL0937 CF  (active-power pulse), ADC-capable pad kept in
 *                 reserve in case pulse counting needs an analog fallback
 *   D3 / P0.29  - BL0937 CF1 (V/I pulse, muxed by SEL), same ADC reasoning
 *   D4 / P0.04  - BL0937 SEL (V/I select output)
 *   D6 / P1.11  - relay drive (digital-only pad; the relay needs no ADC)
 *   P0.17       - plug LED 1 (relay state indicator). This pin is wired on
 *                 the XIAO module as CHARGE_LED but is NOT declared in the
 *                 board devicetree and NOT on the edge connector -- it
 *                 drives the module's own (unpopulated-in-this-design)
 *                 battery charge LED and is otherwise idle on a mains plug
 *                 with no battery. Reusing it here frees a connector pad.
 *
 * The plug has two LEDs, not one -- see docs/original-pcb-trace.md. LED 1
 * (P0.17) mirrors relay state; LED 2 (D1) mirrors network/commissioning
 * state. Splitting the two facts across separate LEDs avoids a precedence
 * conflict on a single shared LED. See "Indication design" in
 * docs/smart-plug-plan.md.
 *
 * Both LEDs' polarity is assumed active-low, matching the on-board RGB LED
 * (xiao_ble_common.dtsi); confirm independently during tracing -- they may
 * not share polarity.
 *
 * D5/D7-D10 are deliberately left unused as spares (D4/D5 are the I2C
 * pair, D6/D7 the UART pair -- avoided for a possible future sensor).
 *
 * All GPIO producer/consumer nodes below reuse Zephyr's "gpio-leds" /
 * "gpio-keys" bindings even where the node is not literally an LED or a key
 * (SEL is an output that is neither; CF/CF1 are pulse inputs, not buttons).
 * That is deliberate, not cosmetic: only a node with a *binding* gets its
 * "gpios" property expanded by the devicetree generator into the .port/.pin
 * fields GPIO_DT_SPEC_GET() needs -- a bare node with no "compatible" does
 * not, and fails to build. gpio-leds/gpio-keys are simply the two bindings
 * Zephyr ships whose child schema is "one gpios property, nothing else",
 * which is all any of these signals needs; no LED or button driver actually
 * attaches to bl0937_sel/cf/cf1 or relay_drive, they're read/driven with
 * plain GPIO calls the same way src/status_led.cpp and src/relay.cpp already
 * do for led0-led4.
 */

/ {
	buttons {
		compatible = "gpio-keys";

		button0: button_0 {
			gpios = <&gpio0 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Plug switch (D0)";
		};
	};

	bl0937_pulses: bl0937_pulses {
		compatible = "gpio-keys";

		bl0937_cf: bl0937_cf {
			gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
			label = "BL0937 CF (D2)";
		};

		bl0937_cf1: bl0937_cf1 {
			gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>;
			label = "BL0937 CF1 (D3)";
		};
	};

	aliases {
		sw0 = &button0;
		led3 = &plug_led_relay;
		led4 = &plug_led_network;
	};

	leds {
		compatible = "gpio-leds";

		plug_led_relay: plug_led_relay {
			gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;
			label = "Plug LED 1 (relay state)";
		};

		plug_led_network: plug_led_network {
			gpios = <&gpio0 3 GPIO_ACTIVE_LOW>;
			label = "Plug LED 2 (network state, D1)";
		};

		relay_drive: relay_drive {
			gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
			label = "Relay drive (D6)";
		};

		bl0937_sel: bl0937_sel {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "BL0937 SEL (D4)";
		};
	};
};
